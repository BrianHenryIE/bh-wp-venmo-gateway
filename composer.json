{
    "name": "brianhenryie/bh-wp-venmo-gateway",
    "description": "Receive Venmo payments on your WordPress WooCommerce/Give site. Reconciles payments via email.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0+-or-later",
    "authors": [
        {
            "name": "Brian Henry",
            "email": "BrianHenryIE@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "johnpbloch/wordpress-core-installer": true,
            "phpstan/extension-installer": true,
            "cweagans/composer-patches": true
        },
        "platform": {
            "php": "8.4"
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "repositories": {
        "brianhenryie/strauss": {
            "type": "package",
            "package": {
                "name": "brianhenryie/strauss",
                "version": "0.28.1",
                "dist": {
                    "url": "https://github.com/BrianHenryIE/strauss/releases/download/0.28.1/strauss.phar",
                    "type": "phar"
                },
                "installation-source": "dist",
                "bin": "bin/strauss"
            }
        },
        "wordpress/wordpress": {
            "type": "git",
            "url": "https://github.com/WordPress/wordpress-develop.git",
            "only": [
                "wordpress/wordpress"
            ]
        },
        "outlandish/wpackagist": {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*",
                "wpackagist-theme/*"
            ]
        }
    },
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "alleyinteractive/wordpress-autoloader": "*",
        "brianhenryie/bh-wp-order-email-reconcile": "dev-master",
        "brianhenryie/bh-wp-logger": "^0.3.4",
        "chillerlan/php-qrcode": "^5.0"
    },
    "require-dev": {
        "10up/wp_mock": "^1.1",
        "brianhenryie/strauss": "0.28.1",
        "antecedent/patchwork": "^2.2",
        "brianhenryie/color-logger": "*",
        "johnpbloch/wordpress": "*",
        "lucatume/wp-browser": "^4.5",
        "php-stubs/woocommerce-stubs": "*",
        "phpstan/extension-installer": "*",
        "phpunit/phpcov": "*",
        "rector/rector": "^2.3",
        "szepeviktor/phpstan-wordpress": "*",
        "wordpress/wordpress": ">=6.9",
        "wp-coding-standards/wpcs": "*",
        "wpackagist-plugin/checkout-fees-for-woocommerce": "^2.19",
        "wpackagist-plugin/give": "^4",
        "wpackagist-plugin/query-monitor": "*",
        "wpackagist-plugin/woocommerce": ">=10.5",
        "wpackagist-plugin/wp-mail-debugger": "^1.1",
        "wpackagist-theme/twentytwenty": "*"
    },
    "autoload": {
        "classmap": [
            "includes"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "BrianHenryIE\\WP_Venmo_Gateway\\": [
                "tests/unit",
                "tests/wpunit",
                "tests/integration"
            ]
        },
        "classmap": [
            "tests/unit",
            "tests/wpunit",
            "tests/integration",
            "tests/_support"
        ]
    },
    "extra": {
        "strauss": {
            "namespace_prefix": "BrianHenryIE\\WP_Venmo_Gateway\\",
            "classmap_prefix": "BH_WP_Venmo_Gateway_",
            "namespace_replacement_patterns": {
                "~BrianHenryIE\\\\(.*)~": "BrianHenryIE\\WP_Venmo_Gateway\\\\$1"
            }
        }
    },
    "scripts": {
        "prefix-namespaces": [
            "php -d memory_limit=1G vendor/bin/strauss --info"
        ],
        "post-install-cmd": [
            "@prefix-namespaces"
        ],
        "post-update-cmd": [
            "@prefix-namespaces"
        ],
        "post-autoload-dump": [
            "vendor/bin/strauss include-autoloader",
            "php ./bin/sync-composer-wpenv.php",
            "php ./bin/modify-autoload-patchwork.php",
            "php ./bin/wpenv-mappings-to-phpstorm.php"
        ],
        "test": [
            "codecept run unit",
            "codecept run wpunit"
        ],
        "test-coverage": [
            "codecept run unit --coverage unit.cov",
            "codecept run wpunit --coverage wpunit.cov",
            "phpcov merge --clover tests/_output/clover.xml --html tests/_output/html tests/_output;",
            "open tests/_output/html/index.html"
        ],
        "cs": [
            "phpcs || true",
            "phpstan analyse --memory-limit 1G"
        ],
        "cs-fix": [
            "phpcbf || true",
            "@cs"
        ],
        "cs-strict": [
            "phpcs || true",
            "phpstan analyse --level max --memory-limit 1G"
        ],
        "cs-changes": [
            "updated_files=$(echo $(git diff --name-only `git merge-base origin/master HEAD` | grep \\.php | tr '\\n' '\\0' | xargs -0 ls -1df 2>/dev/null)); if [ -n \"$updated_files\" ]; then phpcbf $(echo $updated_files); phpcs $(echo $updated_files); phpstan analyse $(echo $updated_files) --memory-limit 1G; else echo \"No modified php files for phpstan.\"; fi;"
        ],
        "cs-changes-strict": [
            "updated_files=$(echo $(git diff --name-only `git merge-base origin/master HEAD` | grep \\.php | tr '\\n' '\\0' | xargs -0 ls -1df 2>/dev/null)); if [ -n \"$updated_files\" ]; then phpcbf $(echo $updated_files); phpcs $(echo $updated_files); phpstan analyse $(echo $updated_files) --level max --memory-limit 1G; else echo \"No modified php files for phpstan.\"; fi;"
        ],
        "create-plugin-archive": [
            "wp dist-archive . ./dist-archive --plugin-dirname=$(basename \"$PWD\") --create-target-dir"
        ],
        "github-actions": [
            "act -P ubuntu-latest=shivammathur/node:latest"
        ]
    }
}
