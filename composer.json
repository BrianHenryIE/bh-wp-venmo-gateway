{
    "name": "brianhenryie/bh-wc-venmo-gateway",
    "description": "Receive Venmo payments on your WooCommerce store. Reconciles payments via email.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0+-or-later",
    "authors": [
        {
            "name": "Brian Henry",
            "email": "BrianHenryIE@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "johnpbloch/wordpress-core-installer": true,
            "phpstan/extension-installer": true,
            "cweagans/composer-patches": true
        },
        "platform": {
            "php": "8.0"
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "repositories": [
        {
            "url": "https://github.com/WordPress/wordpress-develop",
            "type": "git"
        },
        {
            "type": "path",
            "url": "../bh-wc-order-email-reconcile/"
        },
        {
            "type": "path",
            "url": "../bh-wp-mailboxes/"
        },
        {
            "type": "composer",
            "url": "https://wpackagist.org"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-json": "*",
        "alleyinteractive/wordpress-autoloader": "*",
        "brianhenryie/bh-wc-order-email-reconcile": "dev-master",
        "brianhenryie/bh-wp-logger": "^0.2",
        "chillerlan/php-qrcode": "^5.0"
    },
    "require-dev": {
        "10up/wp_mock": "^1.1",
        "antecedent/patchwork": "^2.2",
        "brianhenryie/color-logger": "*",
        "brianhenryie/php-codecoverage-markdown": "*",
        "brianhenryie/strauss": "^0.26",
        "johnpbloch/wordpress": "*",
        "lucatume/wp-browser": "^4.5",
        "phpstan/extension-installer": "*",
        "phpunit/phpcov": "*",
        "rector/rector": "^2.3",
        "szepeviktor/phpstan-wordpress": "*",
        "wordpress/wordpress": ">=6.9",
        "wp-cli/dist-archive-command": "*",
        "wp-cli/wp-cli-bundle": "*",
        "wp-coding-standards/wpcs": "*",
        "wpackagist-plugin/checkout-fees-for-woocommerce": "^2.19",
        "wpackagist-plugin/query-monitor": "*",
        "wpackagist-plugin/woocommerce": ">=10.5",
        "wpackagist-theme/twentytwenty": "*"
    },
    "autoload": {
        "classmap": [
            "includes"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "BrianHenryIE\\WC_Venmo_Gateway\\": [
                "tests/unit",
                "tests/wpunit",
                "tests/integration"
            ]
        },
        "classmap": [
          "tests/unit",
          "tests/wpunit",
          "tests/integration",
          "tests/_support"
        ]
    },
    "extra": {
        "strauss": {
            "namespace_prefix": "BrianHenryIE\\WC_Venmo_Gateway\\",
            "classmap_prefix": "BH_WC_Venmo_Gateway_",
            "exclude_from_copy": {
                "file_patterns": [
                    "~psr/log/Psr/Log/Test.*~"
                ]
            },
            "namespace_replacement_patterns": {
                "~BrianHenryIE\\\\(.*)~": "BrianHenryIE\\WC_Venmo_Gateway\\\\$1"
            }
        },
        "google/apiclient-services": [
            "Gmail"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "strauss --info",
            "@sync-composer-wpenv"
        ],
        "post-update-cmd": [
            "strauss --info",
            "@sync-composer-wpenv"
        ],
        "sync-composer-wpenv": [
            "for name in $(cat .wp-env.json | jq '.mappings | values[]' | sed -r 's/^\\\"|\\\"$//g'); do [ ! -d $name ] && [ ! -f $name ] && echo $name && jq 'del(.. | select(. ==\"'$name'\"))' .wp-env.json | sponge .wp-env.json || true; done",
            "find wp-content/plugins -type d -depth 1 ! -type l | sort -h | jq -Rn '[inputs]' | jq 'reduce .[] as $item ({}; . + {$item:$item})' | jq '.[] |= \"./\\(.)\"' | jq '. | {mappings: .}' | jq --sort-keys -s '.[] * $existing[]' --slurpfile existing .wp-env.json | sponge .wp-env.json"
        ],
        "test": [
            "codecept run unit",
            "codecept run wpunit"
        ],
        "test-coverage": [
            "codecept run unit --coverage unit.cov",
            "codecept run wpunit --coverage wpunit.cov",
            "phpcov merge --clover tests/_output/clover.xml --html tests/_output/html tests/_output;",
            "open tests/_output/html/index.html"
        ],
        "cs": [
            "phpcs || true",
            "phpstan analyse --memory-limit 1G"
        ],
        "cs-fix": [
            "phpcbf || true",
            "@cs"
        ],
        "cs-strict": [
            "phpcs || true",
            "phpstan analyse --level max --memory-limit 1G"
        ],
        "cs-changes": [
            "updated_files=$(echo $(git diff --name-only `git merge-base origin/master HEAD` | grep \\.php | tr '\\n' '\\0' | xargs -0 ls -1df 2>/dev/null)); if [ -n \"$updated_files\" ]; then phpcbf $(echo $updated_files); phpcs $(echo $updated_files); phpstan analyse $(echo $updated_files) --memory-limit 1G; else echo \"No modified php files for phpstan.\"; fi;"
        ],
        "cs-changes-strict": [
            "updated_files=$(echo $(git diff --name-only `git merge-base origin/master HEAD` | grep \\.php | tr '\\n' '\\0' | xargs -0 ls -1df 2>/dev/null)); if [ -n \"$updated_files\" ]; then phpcbf $(echo $updated_files); phpcs $(echo $updated_files); phpstan analyse $(echo $updated_files) --level max --memory-limit 1G; else echo \"No modified php files for phpstan.\"; fi;"
        ],
        "create-plugin-archive": [
            "wp dist-archive . ./dist-archive --plugin-dirname=$(basename \"$PWD\") --create-target-dir"
        ]
    }
}
